<?xml version="1.0" encoding="utf-8"?>
<!--
    Aucune permission INTERNET, jamais : Hora est hors ligne par construction. La
    release échoue si une dépendance en ajoute une (vérification sur l'APK).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Sauvegarde Android : rien vers le cloud (aucun service Google), transfert
        d'appareil à appareil autorisé. La sauvegarde de Hora se fait en local (J4).
    -->
    <application
        android:name=".HoraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_cadran"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_cadran"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hora"
        tools:ignore="DataExtractionRules">

        <!-- Pas de filtre LAUNCHER ici : ce sont les alias ci-dessous, un par icône au choix. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Hora.Splash" />

        <!-- Alarme plein écran : par-dessus le verrouillage, hors des applications récentes. -->
        <activity
            android:name=".reminders.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Hora" />

        <!-- Partage d'un événement : le .ics passe à l'application choisie, sans permission de stockage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Icônes au choix (Réglages → Icône) : un alias par icône, un seul activé à la
            fois. Les noms de classe ne se renomment jamais (ils retiennent le choix).
        -->
        <activity-alias
            android:name=".IconCadran"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cadran"
            android:roundIcon="@mipmap/ic_launcher_cadran"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
