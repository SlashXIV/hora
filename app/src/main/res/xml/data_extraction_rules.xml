<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : aucune copie vers le cloud ; le transfert direct vers un nouvel appareil reste possible. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
    </device-transfer>
</data-extraction-rules>
