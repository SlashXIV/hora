<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Thème de démarrage, déclaré au manifeste : Android peint la fenêtre avec lui
        avant la moindre ligne de code. L'avant-plan de l'icône sur le fond lapis : le
        lancement prolonge la tuile du lanceur. Avant Android 12, icône fixe.
    -->
    <style name="Theme.Hora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Hora</item>
    </style>

    <!--
        Thème une fois démarré. Compose dessine tout : la fenêtre ne fournit que le
        fond, visible le temps d'une recomposition. Thème du framework, pas Material.
    -->
    <style name="Theme.Hora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
