<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 et plus : l'ombre du style tourne d'un cran au démarrage (avd_splash). -->
    <style name="Theme.Hora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Hora</item>
    </style>
</resources>
